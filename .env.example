# ======================
# Database (PostgreSQL)
# ======================
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=endurohub
DATABASE_USER=enduro
DATABASE_PASSWORD=changeme

# ======================
# Django
# ======================
DJANGO_SECRET_KEY=change-this-to-a-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,api

# ======================
# SvelteKit
# ======================
# Internal URL for SSR server-side fetches (docker network)
API_URL_INTERNAL=http://api:8000
# Public URL prefix for client-side API calls (proxied by nginx)
PUBLIC_API_URL=/api

# ======================
# OAuth (Django api — 소셜 로그인/가입)
# 각 콘솔에 Redirect URI 등록: {PUBLIC_APP_URL}/auth/{kakao|naver|google}/callback
# ======================
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SvelteKit: 로그인 시작 시 redirect_uri 생성용 (운영 도메인과 일치해야 함)
PUBLIC_APP_URL=

# ======================
# Redis
# ======================
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ======================
# Telegram (runninggal 모니터 알림 + 500 에러 알림)
# ======================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ======================
# External Services
# ======================
KAKAO_JAVASCRIPT_KEY=
NAVER_MAP_CLIENT_ID=
GOOGLE_ANALYTICS_ID=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
GOOGLE_FEEDBACK_FORM_URL=
SLACK_BOT_USER_OAUTH_TOKEN=
CRAWLER_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp-image-generation

# LLM — 자연어 대회 검색 파서 (/api/v1/races/search/)
# 미설정(LLM_API_KEY 비움) 시 검색은 제목 키워드 폴백으로 동작합니다.
# provider: anthropic(공식 SDK, Claude) | openai(OpenAI 호환 HTTP, 로컬 LM Studio 등)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# 모델 미지정 시 provider 기본값 사용 (anthropic→claude-opus-4-8, openai→gpt-4o-mini)
LLM_MODEL=
#
# [Claude 예시] LLM_PROVIDER=anthropic, LLM_API_KEY=<sk-ant-...>, LLM_MODEL=claude-haiku-4-5
#   (고빈도 파서라 Haiku 권장. 더 정확도가 필요하면 claude-opus-4-8 / claude-sonnet-4-6)
#
# [로컬 LM Studio 예시] OpenAI 호환 경로 — BASE_URL 은 Docker 안에서 host.docker.internal 사용,
#   JSON 강제는 json_schema(제약 디코딩)로 소형 모델도 안정적.
#   LLM_PROVIDER=openai
#   LLM_API_KEY=lm-studio
#   LLM_BASE_URL=http://host.docker.internal:1234/v1
#   LLM_MODEL=google/gemma-4-e4b
#   LLM_JSON_MODE=json_schema
LLM_BASE_URL=https://api.openai.com/v1
# openai provider 전용: '' (기본) | json_schema (LM Studio·최신 OpenAI) | json_object (OpenAI)
LLM_JSON_MODE=

# ======================
# Email (Gmail SMTP)
# ======================
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Endurance Races <your@gmail.com>

# ======================
# Sentry
# ======================
SENTRY_DSN_API=
SENTRY_DSN_WEB=
