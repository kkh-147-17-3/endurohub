# ======================
# Database (PostgreSQL)
# ======================
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=endurohub
DATABASE_USER=enduro
DATABASE_PASSWORD=changeme

# ======================
# Django
# ======================
DJANGO_SECRET_KEY=change-this-to-a-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,api

# ======================
# SvelteKit
# ======================
# Internal URL for SSR server-side fetches (docker network)
API_URL_INTERNAL=http://api:8000
# Public URL prefix for client-side API calls (proxied by nginx)
PUBLIC_API_URL=/api

# ======================
# OAuth (Django api — 소셜 로그인/가입)
# 각 콘솔에 Redirect URI 등록: {PUBLIC_APP_URL}/auth/{kakao|naver|google}/callback
# ======================
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SvelteKit: 로그인 시작 시 redirect_uri 생성용 (운영 도메인과 일치해야 함)
PUBLIC_APP_URL=

# ======================
# External Services
# ======================
KAKAO_JAVASCRIPT_KEY=
NAVER_MAP_CLIENT_ID=
GOOGLE_ANALYTICS_ID=
GOOGLE_FEEDBACK_FORM_URL=
SLACK_BOT_USER_OAUTH_TOKEN=
CRAWLER_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp-image-generation

# ======================
# Email (Gmail SMTP)
# ======================
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Endurance Races <your@gmail.com>

# ======================
# Sentry
# ======================
SENTRY_DSN_API=
SENTRY_DSN_WEB=
