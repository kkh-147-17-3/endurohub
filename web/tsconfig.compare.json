{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$before/*": ["./src/stories/before/*"]
    }
  },
  "include": ["src/stories/**/*.svelte", "src/stories/fixtures.ts", "src/stories/scenarios.ts", ".storybook/standalone/**/*.ts", ".storybook/mocks/**/*.ts", ".storybook/freeze-clock.ts", "src/app.d.ts", ".svelte-kit/ambient.d.ts", ".svelte-kit/non-ambient.d.ts"],
  "exclude": ["node_modules", "build", "src/stories/**/*.stories.ts"]
}
