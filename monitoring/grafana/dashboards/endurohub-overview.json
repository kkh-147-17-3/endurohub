{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "EnduroHub — Overview",
  "uid": "endurohub-overview",
  "tags": ["endurohub"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "API service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_duration_milliseconds_count, service_name)", "refId": "vars" },
        "refresh": 2,
        "includeAll": false,
        "current": { "text": "endurohub-api", "value": "endurohub-api" }
      }
    ]
  },
  "panels": [
    {
      "type": "row", "title": "RED — HTTP server ($service)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries", "title": "Request rate (req/s) by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_status_code) (rate(http_server_duration_milliseconds_count{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{http_status_code}}"
        }
      ]
    },
    {
      "type": "stat", "title": "Error rate (5xx %)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(http_server_duration_milliseconds_count{service_name=\"$service\",http_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_duration_milliseconds_count{service_name=\"$service\"}[$__rate_interval])), 0.001)"
        }
      ]
    },
    {
      "type": "stat", "title": "Throughput (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"$service\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "timeseries", "title": "Latency (ms) — p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "p50", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "p95", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "p99", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "table", "title": "Top routes — rate & p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "rate", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_target, http_method) (rate(http_server_duration_milliseconds_count{service_name=\"$service\"}[$__rate_interval]))"
        },
        {
          "refId": "p95", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, http_target, http_method) (rate(http_server_duration_milliseconds_bucket{service_name=\"$service\"}[$__rate_interval])))"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "renameByName": { "http_target": "route", "http_method": "method", "Value #rate": "req/s", "Value #p95": "p95 (ms)" }, "excludeByName": { "Time": true } } }
      ]
    },
    {
      "type": "row", "title": "Containers (docker_stats)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "type": "timeseries", "title": "CPU utilization (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(container_cpu_usage_nanoseconds_total{container_name=~\"endurohub-.*\"}[$__rate_interval]) / 1e9",
          "legendFormat": "{{container_name}}"
        }
      ]
    },
    {
      "type": "timeseries", "title": "Memory usage (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "container_memory_usage_total_bytes{container_name=~\"endurohub-.*\"}",
          "legendFormat": "{{container_name}}"
        }
      ]
    },
    {
      "type": "row", "title": "Host disk (hostmetrics)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "gauge", "title": "Root fs usage (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 90 } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(system_filesystem_utilization{mountpoint=\"/\"}) * 100",
          "legendFormat": "/"
        }
      ]
    },
    {
      "type": "timeseries", "title": "Root fs used / total (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "used", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(system_filesystem_usage_bytes{mountpoint=\"/\", state=\"used\"})",
          "legendFormat": "used"
        },
        {
          "refId": "total", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(system_filesystem_usage_bytes{mountpoint=\"/\"})",
          "legendFormat": "total"
        }
      ]
    },
    {
      "type": "row", "title": "Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 }
    },
    {
      "type": "logs", "title": "Recent logs (Loki) — $service",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 36 },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A", "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"$service\"}"
        }
      ]
    }
  ]
}
